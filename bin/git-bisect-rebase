#!/bin/bash

# git-bisect-rebase
# Copyright (c) 2025 Robert (Jamie) Munro
# Licensed under the MIT License
#
# This script attempts to rebase the current branch onto a specified target branch.
# If the initial rebase fails, it uses git-bisect to find the earliest commit
# on the current branch that can be successfully rebased onto the target branch.
# It then performs the rebase up to that point.
#
# Part of Jamie's Git Tools: https://github.com/rjmunro/jamies-git-tools

set -euo pipefail

print_help() {
  echo "Usage: git bisect-rebase [<upstream> [<branch>]]"
  echo ""
  echo "Attempt to rebase <branch> (or current branch) onto <upstream>."
  echo "If the rebase fails due to conflicts, uses git bisect to find the"
  echo "most recent commit that can be successfully rebased."
  echo ""
  echo "This works like 'git rebase <upstream> [<branch>]' but with automatic"
  echo "bisecting to find how much of your branch can be rebased cleanly."
  echo ""
  echo "Options:"
  echo "  --help, -h      Show this help"
  echo ""
  echo "Arguments:"
  echo "  <upstream>  The branch to rebase onto (e.g., main, origin/develop)"
  echo "  <branch>    Optional. The branch to rebase. Defaults to current branch."
  echo ""
  echo "Examples:"
  echo "  git bisect-rebase main           # Rebase current branch onto main"
  echo "  git bisect-rebase main feature   # Rebase feature branch onto main"
  echo "  git bisect-rebase origin/develop # Rebase onto remote develop"
  echo ""
  echo "After completion, run 'git bisect reset' to clean up the bisect state."
  exit 0
}

# --- INTERNAL BISECT TEST FUNCTION ---
# This part is executed when the script is called with the --bisect-test parameter
if [ "${1:-}" == "--bisect-test" ]; then
  # The branch to rebase is passed as the second argument
  BRANCH_TO_REBASE="$2"
  PRE_TEST_HEAD=$(git rev-parse HEAD)
  # If rebase fails, we want to exit with non-zero.
  if git rebase --no-update-refs HEAD "$BRANCH_TO_REBASE"; then
    echo "Rebase test successful for current HEAD."
    git checkout -f "$PRE_TEST_HEAD" # Restore original HEAD
    exit 0 # Bisect 'good'
  else
    echo "Rebase test failed for current HEAD. Aborting rebase for bisect."
    git rebase --abort
    git checkout -f "$PRE_TEST_HEAD" # Restore original HEAD
    exit 1 # Bisect 'bad'
  fi
fi
# --- END INTERNAL BISECT TEST FUNCTION ---


# --- MAIN SCRIPT LOGIC ---

# Parse arguments
UPSTREAM=""
SOURCE_BRANCH=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --help|-h)
      print_help
      ;;
    -*)
      echo "Unknown option: $1"
      echo "Use --help for usage information."
      exit 1
      ;;
    *)
      if [ -z "$UPSTREAM" ]; then
        UPSTREAM="$1"
      elif [ -z "$SOURCE_BRANCH" ]; then
        SOURCE_BRANCH="$1"
      else
        echo "Error: Too many arguments."
        echo "Use --help for usage information."
        exit 1
      fi
      shift
      ;;
  esac
done

# If source branch specified, check it out first
if [ -n "$SOURCE_BRANCH" ]; then
  git checkout "$SOURCE_BRANCH"
fi

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
STASH_PERFORMED=false
BISECT_PERFORMED=false

# Cleanup function to restore stashed changes on exit
cleanup() {
  if [ "$STASH_PERFORMED" = true ]; then
    echo "Restoring stashed changes..."
    if ! git stash pop; then
      echo "Warning: Failed to restore stashed changes. Your changes are still in the stash."
      echo "Run 'git stash pop' manually to restore them."
    fi
  fi
}
trap cleanup EXIT

if [ -z "$UPSTREAM" ]; then
  echo "Error: No upstream branch specified."
  echo ""
  echo "Usage: git bisect-rebase [<upstream> [<branch>]]"
  echo "Use --help for more information."
  exit 1
fi

echo "Attempting to rebase '$CURRENT_BRANCH' onto '$UPSTREAM'..."

# --- STASHING LOGIC START ---
# Check if there are any uncommitted changes (staged or unstaged)
# git update-index --refresh ensures the index is up-to-date
git update-index --refresh >/dev/null 2>&1 || true
if ! git diff-files --quiet --exit-code || ! git diff-index --quiet --exit-code --cached HEAD; then
    # There are changes (unstaged or staged)
    echo "Detected uncommitted changes. Stashing them temporarily..."
    # Using 'git stash push' for modern git, '-m' for message
    git stash push -m "git-bisect-rebase: Temporary stash of working changes" > /dev/null 2>&1
    STASH_PERFORMED=true
fi
# --- STASHING LOGIC END ---

# Try the rebase directly
if git rebase --no-update-refs "$UPSTREAM"; then
  echo "Rebase complete!"
else
  echo "Initial rebase failed. Starting bisect to find the earliest successful rebase point."

  # Abort the failed rebase
  git rebase --abort

  # Get the common ancestor as the start of the bisect range
  COMMON_ANCESTOR=$(git merge-base "$UPSTREAM" "$CURRENT_BRANCH")

  if [ -z "$COMMON_ANCESTOR" ]; then
    echo "Error: Could not find a common ancestor between '$UPSTREAM' and '$CURRENT_BRANCH'."
    echo "This script might not be suitable for branches with no shared history."
    exit 1
  fi

  # Start git bisect
  git bisect start "$UPSTREAM" "$COMMON_ANCESTOR"

  # Run the bisect, calling this script itself as the test
  # We pass '--bisect-test' as the first argument, and the branch to rebase as the second.
  # $0 refers to the name of the current script.
  git bisect run "$0" --bisect-test "$CURRENT_BRANCH"

  BISECT_PERFORMED=true

  # Ensure we're back on the original branch after bisect
  git checkout "$CURRENT_BRANCH"
fi

echo ""
if [ "$BISECT_PERFORMED" = true ]; then
  echo "Bisect-rebase finished. Your branch '$CURRENT_BRANCH' is now at the most recent"
  echo "commit that can be rebased cleanly onto '$UPSTREAM'."
  echo ""
  echo "Next steps:"
  echo "  git rebase refs/bisect/bad  # Try rebasing the first failing commit"
  echo "  git bisect reset            # Clean up bisect state when done"
else
  echo "Rebase of '$CURRENT_BRANCH' onto '$UPSTREAM' completed successfully."
fi
