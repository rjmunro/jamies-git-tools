#!/usr/bin/env python3
"""
git-diff-byte-count
Copyright (c) 2025 Robert (Jamie) Munro
Licensed under the MIT License

Compare code size changes between git commits, with comments and whitespace removed.
Useful for tracking whether a refactor is actually reducing code size.

Part of Jamie's Git Tools: https://github.com/rjmunro/jamies-git-tools

Usage:
  git-diff-byte-count [<commit>]

Arguments:
  <commit>   Commit to compare HEAD against (default: HEAD~1)

Examples:
  git-diff-byte-count
  git-diff-byte-count main
  git-diff-byte-count HEAD~10
"""

import subprocess
import sys
import re
import argparse
from pathlib import Path

# ANSI color codes
RED = '\033[31m'
GREEN = '\033[32m'
WHITE = '\033[37m'
RESET = '\033[0m'

def strip_code(content, filepath):
    """Remove comments and whitespace from code."""
    ext = Path(filepath).suffix

    if ext in {'.py', '.sh'}:
        # Remove # comments (but not shebangs on line 1)
        lines = content.splitlines()
        stripped = []
        for i, line in enumerate(lines):
            if i == 0 and line.startswith('#!'):
                stripped.append(line.strip())
            else:
                line = re.sub(r'#.*$', '', line)
                if line.strip():
                    stripped.append(line.strip())
        return '\n'.join(stripped)
    else:
        # Remove multi-line comments (/* */ and /** */)
        content = re.sub(r'/\*.*?\*/', '', content, flags=re.DOTALL)
        # Remove single-line comments (//)
        content = re.sub(r'//.*$', '', content, flags=re.MULTILINE)
        # Remove blank lines
        lines = [line.strip() for line in content.splitlines() if line.strip()]
        return '\n'.join(lines)

def get_file_content(commit, filepath):
    """Get file content at a specific commit."""
    try:
        result = subprocess.run(
            ['git', 'show', f'{commit}:{filepath}'],
            capture_output=True,
            text=True,
            check=True
        )
        return result.stdout
    except subprocess.CalledProcessError:
        return None

def get_changed_files(commit):
    """Get list of changed files since commit."""
    result = subprocess.run(
        ['git', 'diff', '--name-only', commit],
        capture_output=True,
        text=True,
        check=True
    )
    files = result.stdout.strip()
    return files.split('\n') if files else []

def is_code_file(filepath):
    """Check if file is a code file we should analyze."""
    extensions = {'.ts', '.tsx', '.js', '.jsx', '.py', '.sh'}
    return Path(filepath).suffix in extensions

def main():
    parser = argparse.ArgumentParser(
        prog='git-diff-byte-count',
        description='Compare code size changes between git commits, with comments and whitespace removed.',
        epilog='Part of Jamie\'s Git Tools: https://github.com/rjmunro/jamies-git-tools',
    )
    parser.add_argument('commit', nargs='?', default='HEAD~1',
                        help='Commit to compare HEAD against (default: HEAD~1)')
    args = parser.parse_args()

    commit = args.commit

    print(f"Comparing code size changes from {commit} to HEAD")
    print("Files with comments and whitespace removed:")
    print()

    total_before = 0
    total_after = 0

    for filepath in get_changed_files(commit):
        # Skip if file doesn't exist (deleted) or isn't a code file
        if not Path(filepath).exists() or not is_code_file(filepath):
            continue

        # Get before version
        before_content = get_file_content(commit, filepath)
        if before_content is None:
            continue

        # Get after version
        with open(filepath, 'r', encoding='utf-8') as f:
            after_content = f.read()

        # Strip and measure
        before_stripped = strip_code(before_content, filepath)
        after_stripped = strip_code(after_content, filepath)

        before_bytes = len(before_stripped)
        after_bytes = len(after_stripped)
        diff = after_bytes - before_bytes

        # Format output
        if diff > 0:
            sign = '+'
            color = RED
        elif diff < 0:
            sign = ''
            color = GREEN
        else:
            sign = ' '
            color = WHITE

        print(f"{color}{filepath:<80} {before_bytes:8} -> {after_bytes:8} "
              f"({sign}{diff} bytes){RESET}")

        total_before += before_bytes
        total_after += after_bytes

    print()
    print("-" * 71)

    total_diff = total_after - total_before
    if total_diff > 0:
        sign = '+'
        color = RED
    elif total_diff < 0:
        sign = ''
        color = GREEN
    else:
        sign = ' '
        color = WHITE

    percent = (total_diff * 100 / total_before) if total_before > 0 else 0

    print(f"{color}Total: {total_before:8} -> {total_after:8} "
          f"({sign}{total_diff} bytes, {percent:.1f}% change){RESET}")

if __name__ == '__main__':
    main()
